     }
 #endif
 
-    return FileSystem::pathByAppendingComponent(FileSystem::stringFromFileSystemRepresentation(PKGLIBEXECDIR), processName);
+    return FileSystem::pathByAppendingComponent(FileSystem::stringFromFileSystemRepresentation(relocatedInstallPath(PKGLIBEXECDIR).data()), processName);
 }
 
