diff --git a/Source/WebKit/Shared/glib/ProcessExecutablePathGLib.cpp b/Source/WebKit/Shared/glib/ProcessExecutablePathGLib.cpp
index 64bcde96..02df2a1a 100644
--- a/Source/WebKit/Shared/glib/ProcessExecutablePathGLib.cpp
+++ b/Source/WebKit/Shared/glib/ProcessExecutablePathGLib.cpp
@@ -27,11 +27,61 @@
 #include "config.h"
 #include "ProcessExecutablePath.h"
 
+#include <dlfcn.h>
 #include <glib.h>
+#include <limits.h>
+#include <stdlib.h>
+#include <string.h>
+#include <wtf/NeverDestroyed.h>
+#include <wtf/glib/GUniquePtr.h>
 #include <wtf/FileSystem.h>
 
 namespace WebKit {
 
+#if defined(WEBKIT_INSTALL_PREFIX)
+static CString runtimeInstallPrefix()
+{
+    static constexpr const char* buildPrefix = WEBKIT_INSTALL_PREFIX;
+    static constexpr const char* buildLibDir = LIBDIR;
+    size_t prefixLength = strlen(buildPrefix);
+    if (strncmp(buildLibDir, buildPrefix, prefixLength) || buildLibDir[prefixLength] != '/')
+        return { };
+    // The library directory below the prefix, for example "lib".
+    const char* relativeLibDir = buildLibDir + prefixLength + 1;
+
+    Dl_info info;
+    if (!dladdr(reinterpret_cast<void*>(&relocatedInstallPath), &info) || !info.dli_fname)
+        return { };
+    char resolved[PATH_MAX];
+    if (!realpath(info.dli_fname, resolved))
+        return { };
+    GUniquePtr<char> libraryDir(g_path_get_dirname(resolved));
+    size_t libraryDirLength = strlen(libraryDir.get());
+    size_t relativeLength = strlen(relativeLibDir);
+    if (libraryDirLength <= relativeLength + 1)
+        return { };
+    const char* suffix = libraryDir.get() + libraryDirLength - relativeLength;
+    if (strcmp(suffix, relativeLibDir) || suffix[-1] != '/')
+        return { };
+    return CString(std::span<const char>(libraryDir.get(), libraryDirLength - relativeLength - 1));
+}
+#endif
+
+CString relocatedInstallPath(const char* path)
+{
+#if defined(WEBKIT_INSTALL_PREFIX)
+    static NeverDestroyed<CString> prefix = runtimeInstallPrefix();
+    static constexpr const char* buildPrefix = WEBKIT_INSTALL_PREFIX;
+    size_t prefixLength = strlen(buildPrefix);
+    if (prefix->isNull() || strncmp(path, buildPrefix, prefixLength) || (path[prefixLength] && path[prefixLength] != '/'))
+        return path;
+    GUniquePtr<char> relocated(g_strconcat(prefix->data(), path + prefixLength, nullptr));
+    return relocated.get();
+#else
+    return path;
+#endif
+}
+
 #if ENABLE(DEVELOPER_MODE)
 static String getExecutablePath()
 {
