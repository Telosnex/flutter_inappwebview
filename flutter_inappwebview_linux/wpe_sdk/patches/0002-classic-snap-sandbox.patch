+bool isInsideClassicSnap()
+{
+    // Telosnex: a classic Snap runs unconfined, like a native package, so
+    // WebKit's own sandbox is wanted. snap.yaml is the check GLib uses.
+    static bool returnValue = []() -> bool {
+        const char* snap = g_getenv("SNAP");
+        if (!snap || !g_getenv("SNAP_NAME") || !g_getenv("SNAP_REVISION"))
+            return false;
+        GUniquePtr<char> path(g_build_filename(snap, "meta", "snap.yaml", nullptr));
+        GUniqueOutPtr<char> contents;
+        if (!g_file_get_contents(path.get(), &contents.outPtr(), nullptr, nullptr))
+            return false;
+        GUniquePtr<char*> lines(g_strsplit(contents.get(), "\n", -1));
+        for (char** line = lines.get(); *line; ++line) {
+            if (g_str_has_prefix(*line, "confinement:"))
+                return !g_strcmp0(g_strstrip(*line + sizeof("confinement:") - 1), "classic");
+        }
+        return false;
+    }();
+    return returnValue;
+}
+
 bool isInsideSnap()
 {
     // The "SNAP" environment variable is not unlikely to be set for/by something other
     // than Snap, so check a couple of additional variables to avoid false positives.
     // See: https://snapcraft.io/docs/environment-variables
-    static bool returnValue = g_getenv("SNAP") && g_getenv("SNAP_NAME") && g_getenv("SNAP_REVISION");
+    static bool returnValue = g_getenv("SNAP") && g_getenv("SNAP_NAME") && g_getenv("SNAP_REVISION") && !isInsideClassicSnap();
     return returnValue;
 }
 
+CString sandboxHelperPath(const char* path)
+{
+    // Telosnex: an app that bundles bwrap and xdg-dbus-proxy (a classic
+    // Snap, a package under /opt) names their folder; the host may not have
+    // them.
+    if (const char* dir = g_getenv("WEBKIT_SANDBOX_HELPERS_DIR")) {
+        GUniquePtr<char> basename(g_path_get_basename(path));
+        GUniquePtr<char> bundled(g_build_filename(dir, basename.get(), nullptr));
+        if (g_file_test(bundled.get(), G_FILE_TEST_IS_EXECUTABLE))
+            return CString(bundled.get());
+    }
+    return CString(path);
+}
+
 bool shouldUseBubblewrap()
 {
 #if ENABLE(BUBBLEWRAP_SANDBOX)
